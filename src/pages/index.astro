---
import '../styles/global.css';
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alok Sharma — Senior Software Engineer</title>
    <meta name="description" content="Alok Sharma — Senior Software Engineer and GRC Platform Engineer. Multi-tenant SaaS, compliance automation, GDPR/ISO 27001/SOC 2/DPDP." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://at0k.com/" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://at0k.com/" />
    <meta property="og:title" content="Alok Sharma — Senior Software Engineer" />
    <meta property="og:description" content="Senior Software Engineer and GRC Platform Engineer. Multi-tenant SaaS, compliance automation, GDPR/ISO 27001/SOC 2/DPDP." />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Alok Sharma — Senior Software Engineer" />
    <meta name="twitter:description" content="Senior Software Engineer and GRC Platform Engineer. Multi-tenant SaaS, compliance automation, GDPR/ISO 27001/SOC 2/DPDP." />
  </head>
  <body class="bg-[#0a0a0a] text-white antialiased">
    <Nav />
    <main>
      <Hero />
      <Projects />
      <Experience />
      <Skills />
      <Contact />
    </main>
    <Footer />
  </body>
</html>
