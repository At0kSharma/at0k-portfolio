---
import { DOMAINS } from "../config/content";
---

<section id="domains">
  <div class="band">
    <h2>Domains</h2>
    <em>what survives a change of stack</em>
  </div>

  <div class="kit">
    {DOMAINS.map((group) => (
      <div>
        <h3>{group.label}</h3>
        <p>{group.items.join(", ")}</p>
      </div>
    ))}
  </div>
</section>
