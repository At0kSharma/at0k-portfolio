---
import { CONTACT } from "../config/content";
---
<section id="contact">
  <div class="band">
    <h2>Contact</h2>
    <em>replies within a day</em>
  </div>

  <dl class="reach">
    <div>
      <dt>Email</dt>
      <dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd>
    </div>
    <div>
      <dt>LinkedIn</dt>
      <dd><a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer">{CONTACT.linkedinLabel}</a></dd>
    </div>
    <div>
      <dt>GitHub</dt>
      <dd><a href={CONTACT.github} target="_blank" rel="noopener noreferrer">{CONTACT.githubLabel}</a></dd>
    </div>
  </dl>
</section>
