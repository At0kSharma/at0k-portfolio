---
import { CONTACT } from "../config/content";
---
<section id="contact" class="py-16 sm:py-24 px-6 border-t border-white/10">
  <div class="mx-auto max-w-6xl">
    <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">Get in touch</h2>
    <p class="text-gray-400 mb-10 max-w-2xl">
      Open to conversations about GRC platforms, compliance automation and multi-tenant SaaS.
    </p>
    <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8 mb-10">
      <a
        href={`mailto:${CONTACT.email}`}
        class="text-base text-white hover:text-brand transition-colors font-mono"
      >{CONTACT.email}</a>
      <a
        href={CONTACT.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-base text-white hover:text-brand transition-colors font-mono"
      >{CONTACT.githubLabel}</a>
      <a
        href={CONTACT.phoneHref}
        class="text-base text-white hover:text-brand transition-colors font-mono"
      >{CONTACT.phone}</a>
    </div>
    <a
      href={CONTACT.resumeFile}
      class="inline-block px-6 py-3 rounded-xl bg-brand hover:bg-brand/90 text-white text-sm font-semibold transition-colors"
    >Download résumé (PDF)</a>
  </div>
</section>
