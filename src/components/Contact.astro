---
import { CONTACT, EDUCATION } from "../config/content";
---
<section id="contact">
  <div class="band">
    <h2>Contact</h2>
    <em>replies within a day</em>
  </div>

  <dl class="reach">
    <div>
      <dt>Email</dt>
      <dd><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></dd>
    </div>
    <div>
      <dt>GitHub</dt>
      <dd><a href={CONTACT.github} target="_blank" rel="noopener noreferrer">{CONTACT.githubLabel}</a></dd>
    </div>
    <div>
      <dt>Phone</dt>
      <dd><a href={CONTACT.phoneHref}>{CONTACT.phone}</a></dd>
    </div>
    <div>
      <dt>Education</dt>
      <dd>{EDUCATION.degree} — {EDUCATION.institution}, {EDUCATION.year}</dd>
    </div>
  </dl>
</section>
