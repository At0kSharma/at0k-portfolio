---
import { SKILLS } from "../config/content";
---
<section id="skills">
  <div class="band">
    <h2>Stack</h2>
    <em>what I reach for</em>
  </div>

  <div class="kit">
    {SKILLS.map((group) => (
      <div>
        <h3>{group.label}</h3>
        <p>{group.items.join(", ")}</p>
      </div>
    ))}
  </div>
</section>
