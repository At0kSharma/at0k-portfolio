---
import { EXPERIENCE } from "../config/content";
---
<section id="history">
  <div class="band">
    <h2>History</h2>
    <em>2020 — present</em>
  </div>

  {EXPERIENCE.map((role) => (
    <article class="stint">
      <div class="when">{role.period}</div>
      <div>
        <h3>{role.title}</h3>
        <p class="at">{role.company}</p>
        <ul>
          {role.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
      </div>
    </article>
  ))}
</section>
