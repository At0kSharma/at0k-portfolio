---
import { CONTACT } from "../config/content";
---
<nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/10 bg-[#0a0a0a]/90 backdrop-blur-sm">
  <div class="mx-auto max-w-6xl px-6 flex items-center justify-between h-16">
    <a href="#top" class="text-white font-bold text-xl tracking-tight">at0k</a>
    <div class="flex items-center gap-5 sm:gap-6">
      <a href="#projects" class="hidden sm:inline text-sm text-gray-400 hover:text-white transition-colors">Projects</a>
      <a href="#experience" class="hidden sm:inline text-sm text-gray-400 hover:text-white transition-colors">Experience</a>
      <a href="#skills" class="hidden sm:inline text-sm text-gray-400 hover:text-white transition-colors">Skills</a>
      <a
        href={CONTACT.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-gray-400 hover:text-white transition-colors"
      >GitHub</a>
      <a
        href="#contact"
        class="text-sm px-4 py-1.5 rounded-full border border-white/20 text-white hover:bg-white/10 transition-colors"
      >Contact</a>
    </div>
  </div>
</nav>
