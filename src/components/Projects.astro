---
import { PROJECTS } from "../config/content";
---
<section id="work">
  <div class="band">
    <h2>Work</h2>
    <em>one system you can sign into right now</em>
  </div>

  <div class="work">
    {PROJECTS.map((project) => (
      <article class="job">
        <div>
          <h3>{project.name}</h3>
          <p class="kicker">{project.tagline}</p>
          <p class="prose">{project.description}</p>
          {project.counts && (
            <p class="counts">
              {project.counts.map((c) => (
                <span><b>{c.value}</b> {c.label}</span>
              ))}
            </p>
          )}
          <p class="stack">{project.stack.join("  ·  ")}</p>
        </div>

        {project.demo && project.link ? (
          <div class="grant">
            <div class="grant-top">
              <span>demo access</span>
              <a href={project.link.href} target="_blank" rel="noopener noreferrer">
                {project.link.label}
              </a>
            </div>
            <dl>
              <dt>email</dt><dd>{project.demo.email}</dd>
              <dt>password</dt><dd>{project.demo.password}</dd>
            </dl>
          </div>
        ) : project.noAccess ? (
          <p class="noaccess">
            {project.noAccess.map((line) => <span>{line}</span>)}
          </p>
        ) : null}
      </article>
    ))}
  </div>
</section>
