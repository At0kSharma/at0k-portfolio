---
import { PROJECTS } from "../config/content";

// Derived rather than declared: a project is live because it has somewhere to
// point at, and open because it has credentials published. Neither tally can
// disagree with the records underneath it.
const live = PROJECTS.filter((project) => project.link).length;
const open = PROJECTS.filter((project) => project.demo).length;
---

<section id="work">
  <div class="band">
    <h2>Work</h2>
    <em>{live} live · {open} you can sign into right now</em>
  </div>

  <div class="work">
    {PROJECTS.map((project) => (
      <article class="job">
        <div>
          <div class="title">
            {/* Decorative: whether a project is live is already stated by the
                link in the grant header or by the note that replaces it. */}
            <span class={project.link ? "dot" : "dot closed"} aria-hidden="true"></span>
            <h3>{project.name}</h3>
          </div>
          <p class="kicker">{project.tagline}</p>
          <p class="prose">{project.description}</p>
          {project.counts && (
            <p class="counts">
              {project.counts.map((c) => (
                <span><b>{c.value}</b> {c.label}</span>
              ))}
            </p>
          )}
          <p class="stack">{project.stack.join("  ·  ")}</p>
        </div>

        {project.demo && project.link ? (
          <div class="grant">
            <div class="grant-top">
              <span>demo access</span>
              <a href={project.link.href} target="_blank" rel="noopener noreferrer">
                {project.link.label}
              </a>
            </div>
            <dl>
              <dt>email</dt>
              <dd>
                <span>{project.demo.email}</span>
                <button class="copy" type="button" data-copy={project.demo.email}>copy</button>
              </dd>
              <dt>password</dt>
              <dd>
                <span>{project.demo.password}</span>
                <button class="copy" type="button" data-copy={project.demo.password}>copy</button>
              </dd>
            </dl>
          </div>
        ) : project.noAccess ? (
          <p class="noaccess">
            {project.noAccess.map((line) => <span>{line}</span>)}
          </p>
        ) : null}
      </article>
    ))}
  </div>
</section>

<script>
  // Credentials are meant to be used, not retyped. The button reverts on its
  // own so the control never sits lying about a copy made minutes ago.
  document.querySelectorAll<HTMLButtonElement>("button.copy").forEach((button) => {
    button.addEventListener("click", async () => {
      const value = button.dataset.copy;
      if (!value) return;

      try {
        await navigator.clipboard.writeText(value);
        button.textContent = "copied";
        button.dataset.state = "done";
      } catch {
        // Clipboard access can be refused outright (insecure origin, denied
        // permission). Say so rather than claiming a copy that never happened;
        // the value is selectable next to the button either way.
        button.textContent = "select it";
      }

      window.setTimeout(() => {
        button.textContent = "copy";
        delete button.dataset.state;
      }, 2000);
    });
  });
</script>
